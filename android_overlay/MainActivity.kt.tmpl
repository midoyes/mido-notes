package __PACKAGE__

import android.os.Bundle
import android.view.WindowManager
import io.flutter.embedding.android.FlutterFragmentActivity
import io.flutter.embedding.engine.FlutterEngine
import io.flutter.plugin.common.MethodChannel

// local_auth（指紋）需要 FlutterFragmentActivity。
// 預設開啟 FLAG_SECURE（禁止截圖、隱藏多工預覽），之後由 Dart 端依設定切換。
class MainActivity : FlutterFragmentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        window.setFlags(
            WindowManager.LayoutParams.FLAG_SECURE,
            WindowManager.LayoutParams.FLAG_SECURE
        )
    }

    override fun configureFlutterEngine(flutterEngine: FlutterEngine) {
        super.configureFlutterEngine(flutterEngine)
        MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "mido_notes/secure")
            .setMethodCallHandler { call, result ->
                if (call.method == "setSecure") {
                    val on = call.argument<Boolean>("on") ?: true
                    runOnUiThread {
                        if (on) {
                            window.addFlags(WindowManager.LayoutParams.FLAG_SECURE)
                        } else {
                            window.clearFlags(WindowManager.LayoutParams.FLAG_SECURE)
                        }
                    }
                    result.success(null)
                } else {
                    result.notImplemented()
                }
            }

        // 提醒鈴聲：播放系統預設的通知音
        MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "mido_notes/alert")
            .setMethodCallHandler { call, result ->
                if (call.method == "ring") {
                    try {
                        val uri = android.media.RingtoneManager.getDefaultUri(
                            android.media.RingtoneManager.TYPE_NOTIFICATION
                        )
                        android.media.RingtoneManager.getRingtone(applicationContext, uri)?.play()
                    } catch (t: Throwable) {
                    }
                    result.success(null)
                } else {
                    result.notImplemented()
                }
            }

        // AI 文字辨識（PaddleOCR 模型，離線）
        MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "mido_notes/ocr")
            .setMethodCallHandler { call, result ->
                when (call.method) {
                    "available" -> result.success(AiOcr.available(applicationContext))
                    "recognize" -> {
                        val path = call.argument<String>("path")
                        if (path == null) {
                            result.error("args", "missing path", null)
                        } else {
                            Thread {
                                try {
                                    val json = AiOcr.recognize(applicationContext, path)
                                    runOnUiThread { result.success(json) }
                                } catch (t: Throwable) {
                                    runOnUiThread { result.error("ocr", t.toString(), null) }
                                }
                            }.start()
                        }
                    }
                    else -> result.notImplemented()
                }
            }
    }
}
